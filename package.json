{
  "name": "soulcap",
  "private": true,
  "version": "8.2.0",
  "description": "SoulCap PWA \u2014 private, offline-first self-guided wellness tools",
  "scripts": {
    "dev": "python3 -m http.server 8788 --directory docs",
    "test:e2e": "playwright test",
    "test:safety": "playwright test e2e/safety.spec.ts",
    "verify": "npm run test:e2e",
    "gallery": "CAPTURE_GALLERY=1 playwright test e2e/gallery.spec.ts --project=mobile --project=desktop",
    "gallery:view": "python3 -m http.server 8790",
    "test:matrix": "FINISH_MATRIX=1 playwright test e2e/finish-matrix.spec.ts --project=mobile",
    "tier1": "node ../capricorn-tooling/shared/testing/tier1.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
